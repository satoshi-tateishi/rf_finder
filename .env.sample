# Django Settings
SECRET_KEY=django-insecure-default-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*.ngrok-free.app
CSRF_TRUSTED_ORIGINS=http://localhost:8084,https://*.ngrok-free.app

# Database Settings (MySQL)
# format: mysql://user:password@host:port/dbname
DATABASE_URL=mysql://user:password@db:3306/rf_finder

# Email Settings (for sending adjustment forms)
# For development, console backend is default.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost

# Recipient for the adjustment PDF (Radiomic association email)
ADJUSTMENT_EMAIL_TO=

# LINE WORKS WOFF Settings
# Get this from LINE WORKS Developer Console
WOFF_ID=
