# Django設定
DEBUG=False
SECRET_KEY=django-insecure-default-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,*.ngrok-free.app
CSRF_TRUSTED_ORIGINS=http://localhost:8084,https://*.ngrok-free.app

# Docker設定
APP_PORT=8085

# データベース設定 (MySQL)
# 形式: mysql://ユーザー:パスワード@ホスト:ポート/データベース名
DATABASE_URL=mysql://user:password@db:3306/rf_finder

# メール送信設定
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=password
DEFAULT_FROM_EMAIL=webmaster@example.com

# LINE WORKS Bot API設定 (サービスアカウント)
LINE_WORKS_CLIENT_ID=
LINE_WORKS_CLIENT_SECRET=
LINE_WORKS_REDIRECT_URI=http://localhost:8084/auth/lineworks/callback/
LINE_WORKS_SERVICE_ACCOUNT=
LINE_WORKS_DOMAIN=
LINE_WORKS_PRIVATE_KEY_PATH=./keys/line_works_private_key.key
LINE_WORKS_BOT_ID=
LINE_WORKS_NOTIFICATION_CHANNEL_ID=

# Dropbox バックアップ設定
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:8084/auth/dropbox/callback/
