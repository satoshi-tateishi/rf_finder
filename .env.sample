# Django Settings
SECRET_KEY=django-insecure-default-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*.ngrok-free.app
CSRF_TRUSTED_ORIGINS=http://localhost:8084,https://*.ngrok-free.app

# Database Settings (MySQL)
# format: mysql://user:password@host:port/dbname
DATABASE_URL=mysql://user:password@db:3306/rf_finder

# Email Settings (for sending adjustment forms)
# For development, console backend is default.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost

# Recipient for the adjustment PDF (Radiomic association email)
ADJUSTMENT_EMAIL_TO=

# LINE WORKS Bot API Settings (Service Account)
LINE_WORKS_CLIENT_ID=
LINE_WORKS_CLIENT_SECRET=
LINE_WORKS_SERVICE_ACCOUNT=
LINE_WORKS_PRIVATE_KEY_PATH=./keys/line_works_private_key.pem
LINE_WORKS_BOT_ID=
# The specific LW group/channel ID for notifications
LINE_WORKS_NOTIFICATION_CHANNEL_ID=
