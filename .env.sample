# =========================================================
# 1. Django 設定
# =========================================================
DEBUG=False
SECRET_KEY=django-insecure-default-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,*.ngrok-free.app
CSRF_TRUSTED_ORIGINS=http://localhost:8084,https://*.ngrok-free.app

# =========================================================
# 2. Docker 設定
# =========================================================
APP_PORT=8085

# =========================================================
# 3. データベース設定 (MySQL)
# =========================================================
# 形式: mysql://ユーザー:パスワード@ホスト:ポート/データベース名
DATABASE_URL=mysql://user:password@db:3306/rf_finder

# =========================================================
# 4. メール送信設定
# =========================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=password
DEFAULT_FROM_EMAIL=webmaster@example.com

# =========================================================
# 5. LINE WORKS 設定
# =========================================================
LINE_WORKS_CLIENT_ID=
LINE_WORKS_CLIENT_SECRET=
LINE_WORKS_SERVICE_ACCOUNT=
LINE_WORKS_PRIVATE_KEY_PATH=./keys/line_works_private_key.key
LINE_WORKS_BOT_ID=
LINE_WORKS_NOTIFICATION_CHANNEL_ID=

# =========================================================
# 6. Dropbox バックアップ設定
# =========================================================
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:8084/auth/dropbox/callback/

# =========================================================
# 7. shin•on Portal JWT 連携設定
# =========================================================
# PortalJWTMiddleware が portal_jwt クッキーを検証するために使用する
# 開発環境: Portal が localhost で動作している場合
PORTAL_JWKS_URL=http://localhost/api/jwks/
PORTAL_JWT_ISSUER=https://portal.shin-on1981.com
PORTAL_JWT_AUDIENCE=shin-on-apps
PORTAL_LOGIN_URL=http://localhost/login/
# 本番環境:
# PORTAL_JWKS_URL=https://portal.shin-on1981.com/api/jwks/
# PORTAL_LOGIN_URL=https://portal.shin-on1981.com/login/
